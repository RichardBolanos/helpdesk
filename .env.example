# Copia este archivo a ".env" y ajusta los valores:  cp .env.example .env

POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=helpdesk

# JWT: genera una clave larga y aleatoria, por ejemplo con:  openssl rand -hex 32
SECRET_KEY=cambia_esta_clave_secreta
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:4200

# Admin inicial (se crea al arrancar si no existe)
ADMIN_EMAIL=admin@helpdesk.com
ADMIN_PASSWORD=cambia_esta_clave

# Correo (Mailpit en desarrollo; en producción usa tu proveedor SMTP real)
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=HelpDesk <no-reply@helpdesk.com>
FRONTEND_URL=http://localhost:4200
